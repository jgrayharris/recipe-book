  "steps": [
    "Cook the bacon in a large Dutch oven over medium-high heat, stirring often, until crisp, about 12 minutes.",
    "Remove the bacon to a paper-towel-lined plate and reduce the heat to medium. Set aside half the drippings.",
    "Cook the onion and garlic in the pot until the onion is translucent, about 5 minutes.",
    "Stir in the potatoes and cook 5 minutes, adding reserved drippings if they stick.",
    "Sprinkle in the flour and stir for 2 minutes, then slowly pour in the broth, scraping up the bottom of the pot.",
    "Add the milk, salt and pepper and bring to a simmer.",
    "Partly cover and keep at a low simmer until the potatoes are very tender, about 40 minutes.",
    "Mash some of the potatoes for a thicker, less chunky soup.",
    "Stir in the cream and sour cream, then taste and adjust the salt and pepper.",
    "Serve topped with sour cream, cheese, chives and the bacon."
  ],
  "equipment": [
    "Dutch oven"
  ],
  "tips": [
    "Cook the onion in the bacon drippings for the best flavor.",
    "For a smooth soup, blend it with an immersion blender.",
    "For gluten-free, swap the flour for 1 tbsp cornstarch whisked into the milk."
  ],
