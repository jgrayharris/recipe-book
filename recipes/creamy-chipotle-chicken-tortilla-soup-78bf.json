  "steps": [
    "Toss the chicken with oil, salt, pepper, garlic powder, onion powder, cumin, chipotle chili powder and oregano.",
    "Sear the chicken in oil in a Dutch oven, about 5 minutes per side, then remove it.",
    "Add the corn and let it char undisturbed, then remove it and set aside.",
    "Saute the onion, bell pepper and jalapeno until soft, then toast the spices for 30 seconds.",
    "Add the garlic until fragrant, then the tomato paste, and cook until brick red.",
    "Pour in the stock, add the corn tortillas to soften in the hot broth, then blend it with the chipotles and adobo until smooth.",
    "Return the blended mixture to the pot with the diced tomatoes, tomato sauce and chicken, bring to a boil, then simmer 25 minutes.",
    "Blend the cream cheese with a little hot broth, stir it into the pot, then stir in the Jack cheese a handful at a time until melted.",
    "Stir in the corn and black beans, shred the chicken and return it to the pot, and simmer a few minutes.",
    "Finish with lime juice and cilantro, and serve topped with jalapeno, avocado, red onion and crispy tortilla strips."
  ],
  "equipment": [
    "Dutch oven",
    "blender"
  ],
  "tips": [
    "Blend hot liquid in batches with the lid vented to avoid pressure.",
    "Add the cheese gradually, off a hard boil, so it melts smoothly."
  ],
